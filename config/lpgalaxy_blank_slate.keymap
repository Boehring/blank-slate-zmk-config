#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define NAV_L 1
#define NUM_L 2
#define SYM_L 3
#define MEDIA_L 4
#define MOUSE_L 5
#define FUN_L 6
#define BUT_L 7

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick_tap_ms = <200>; };

&sk {
    release-after-ms = <1000>;
    quick-release;
};

/ {
    chosen { zmk,physical-layout = &layout_ortho_4x12_2x2u; };

    // NAV_L + NUM_L held simultaneously activates SYM layer

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_layer {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };

    // Bootloader protected behind deliberate 2-key combo (P + BKSP, top-right corner)
    // Key positions on 4x12: P=10, BKSP=11

    combos {
        compatible = "zmk,combos";

        combo_delete {
            bindings = <&kp DEL>;
            key-positions = <10 11>;
        };
    };

    macros {
        thumbs_up: thumbs_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <5>;
            bindings = <&kp PLUS &kp COLON &kp PLUS &kp N1 &kp COLON &kp RET>;
        };
    };

    tap_dances {
        shifty: shift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFTY";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt_sk: layer_tap_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_STICKY";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&sk>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
&kp ESC        &kp Q          &kp W           &kp E           &kp R        &kp T      &kp Y           &kp U           &kp I          &kp O          &kp P          &kp BACKSPACE
&kp TAB        &hm LGUI A     &hm LALT S      &hm LCTRL D     &hm LSHFT F  &kp G      &kp H           &hm RSHFT J     &hm RCTRL K    &hm RALT L     &hm RGUI SEMI  &kp SINGLE_QUOTE
&shifty        &kp Z          &kp X           &kp C           &kp V        &kp B      &kp N           &kp M           &kp COMMA      &kp DOT        &kp FSLH       &kp RET
&lt_sk 7 LGUI  &lt_sk 5 LALT  &lt_sk 3 LCTRL  &lt_sk 1 LSHFT  &kp SPACE    &kp ENTER  &lt_sk 2 RSHFT  &lt_sk 4 RCTRL  &lt_sk 6 RALT  &lt_sk 7 RGUI
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
&trans  &trans    &trans    &trans     &trans      &trans  &trans  &trans          &trans        &trans          &trans     &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans  &trans  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT  &trans
&trans  &trans    &trans    &trans     &trans      &trans  &trans  &kp PG_DN       &kp PG_UP     &kp INS         &kp HOME   &kp END
&trans  &trans    &trans    &trans     &trans      &trans  &trans  &trans          &trans        &trans
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans            &kp N7        &kp N8        &kp N9        &kp SINGLE_QUOTE   &trans  &trans  &trans      &trans     &trans    &trans    &trans
&kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL          &trans  &trans  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &trans  &trans  &trans      &trans     &trans    &trans    &trans
&kp LEFT_BRACKET  &kp PERIOD    &kp N0        &kp MINUS     &kp RIGHT_BRACKET  &trans  &trans  &trans      &trans     &trans
            >;
        };

        media_layer {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &trans             &trans       &trans             &trans           &trans
&trans  &kp LGUI  &kp RALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &ext_power EP_TOG  &kp C_PREV   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &kp C_STOP         &kp C_PAUSE  &kp C_MUTE         &trans           &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &trans             &trans       &trans
            >;
        };

        sym_layer {
            label = "Sym";
            bindings = <
&trans          &kp LEFT_BRACKET      &kp ASTERISK           &kp AMPS         &kp RIGHT_BRACKET  &kp EQUAL  &trans  &trans     &trans     &trans    &bootloader  &trans
&kp COLON       &kp DOLLAR            &kp PERCENT            &kp CARET        &kp PLUS           &trans     &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI     &trans
&kp TILDE       &kp EXCL              &kp AT                 &kp HASH         &kp PIPE           &trans     &trans  &trans     &trans     &trans    &trans       &trans
&kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp MINUS          &trans     &trans  &trans     &trans     &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
&trans  &kp LGUI  &kp RALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &mkp MB1        &mkp MB2        &mkp MB3      &trans           &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans  &trans          &trans          &trans
            >;
        };

        fun_layer {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp PSCRN        &kp K_APP  &trans        &trans      &trans      &trans    &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11  &kp SLCK         &trans     &kp LSHFT     &kp RCTRL   &kp RALT    &kp RGUI  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F10  &kp PAUSE_BREAK  &trans     &out OUT_TOG  &bt BT_PRV  &bt BT_NXT  &trans    &bt BT_CLR
&trans  &trans  &trans  &trans  &trans   &trans           &trans     &trans        &trans      &trans
            >;
        };

        button_layer {
            bindings = <
&trans      &trans     &trans      &trans       &trans      &trans  &trans  &trans      &trans       &trans      &trans     &trans
&trans      &kp LGUI   &kp LALT    &kp LCTRL    &kp LSHFT   &trans  &trans  &kp RSHFT   &kp RCTRL    &kp RALT    &kp RGUI   &trans
&kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp K_REDO  &trans  &trans  &kp K_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
&trans      &trans     &trans      &trans       &trans      &trans  &trans  &trans      &trans       &trans
            >;
        };
    };
};
